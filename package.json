{
  "name": "@caindev/ui",
  "version": "0.3.0",
  "description": "ESM-only React component library for AI product interfaces, with compiled styles and theme tokens.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "typescript",
    "vite",
    "tailwindcss",
    "base-ui",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carnellai/caindev-ui.git"
  },
  "homepage": "https://github.com/carnellai/caindev-ui#readme",
  "bugs": {
    "url": "https://github.com/carnellai/caindev-ui/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.3"
}
